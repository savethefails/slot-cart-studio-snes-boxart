# Copy this to .env (same folder) and fill it in. .env is ignored by git, so it never gets committed.
# tools/scrape.py and tools/harvest.py read it on their own; no need to export anything.

# The developer ID and password the API is called with.
SS_DEVID=
SS_DEVPASSWORD=

# Your own ScreenScraper login, which carries your daily quota.
SS_SSID=
SS_SSPASSWORD=

# The software name sent with each request. Leave it unless your developer ID's terms name one.
# SS_SOFTNAME=slot-cart-studio
